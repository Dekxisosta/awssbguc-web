# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser or commit to source control.
# Required for the registration/provisioning API routes to create auth users
# and insert profiles using the service role (bypasses Row-Level Security).
SUPABASE_SERVICE_ROLE_KEY=

# Admin API secret — NEVER expose to the browser or commit to source control.
# Protects POST /api/admin/provision from public access.
# Set to any strong random string (e.g. openssl rand -base64 32).
ADMIN_API_SECRET=
