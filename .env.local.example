# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser or commit to source control.
# Required for the registration/provisioning API routes to create auth users
# and insert profiles using the service role (bypasses Row-Level Security).
SUPABASE_SERVICE_ROLE_KEY=

# Admin API secret — NEVER expose to the browser or commit to source control.
# Protects POST /api/admin/provision from public access.
# Set to any strong random string (e.g. openssl rand -base64 32).
ADMIN_API_SECRET=

# Credential emails — optional. Sent through the Gmail API (OAuth2 refresh token) by the admin "Provision" tab.
# Without all four GMAIL_*/MAIL_FROM values, email isn't set up on the server: the Provision tab shows
# the passwords on screen only (copy / CSV) after provisioning.
# OAuth client from Google Cloud Console (Gmail API enabled).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Refresh token granted for the https://www.googleapis.com/auth/gmail.send scope (e.g. via OAuth Playground).
GMAIL_REFRESH_TOKEN=
# Sender, e.g. AWSSBG-UC <accounts@yourdomain.com>. Must be the authorised Gmail account or one of its "Send mail as" aliases.
MAIL_FROM=
# Public site URL (no trailing slash), used for the sign-in link in those emails.
SITE_URL=

# Cron secret — server-only. Protects GET /api/cron/account-deletions, the daily job that erases
# accounts whose 30-day deletion window has passed. Vercel Cron sends it as a Bearer token.
# Set to any strong random string (e.g. openssl rand -base64 32).
CRON_SECRET=

# GitHub token — optional, server-only. Used by the repo showcase to list and verify members' public repos.
# Without it GitHub allows only 60 requests/hour per server IP, which a shared host can exhaust.
# Any token works, including a fine-grained one with no permissions (public data only).
GITHUB_TOKEN=
